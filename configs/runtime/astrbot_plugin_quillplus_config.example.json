    "format_template_plain": "───── 状态栏 ─────\n{content}\n────────────────",
    "plain_platforms": ""
  },
  "refusal": {
    "enabled": true,
    "patterns": "我不能\n我无法\n这违反\n我不应该\n这不合适\n我拒绝"
  },
  "debug": {
    "enabled": false,
    "show_inject_report": false
