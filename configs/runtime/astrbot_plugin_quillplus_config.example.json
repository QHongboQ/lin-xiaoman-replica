  "writing_resource": {
    "enabled": true,
    "max_entries": 4,
    "fallback_top_count": 2,
    "category_dedup_limit": 3
  },
  "performance": {
    "max_prompt_length": 50000,
    "min_output_length": 400,
    "max_output_length": 0
  },
  "status_bar": {
    "enabled": true,
    "fields": "好感度|关系阶段|心情|位置|穿着|当前想法",
