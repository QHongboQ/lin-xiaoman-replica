{
  "log_with_bot_id": {
    "description": "🤖 日志区分机器人实例",
    "type": "bool",
    "default": false,
    "hint": "多 Bot 时在日志前缀区分平台实例（[time_awareness:bot-<self_id>]）；日志级别跟随 AstrBot 原生配置"
  },
  "runtime": {
    "description": "⚙️ 全局运行时参数",
    "type": "object",
    "items": {
      "llm_max_concurrency": {
        "description": "🌐 插件 LLM 全局并发上限",
        "type": "int",
        "default": 0,
        "hint": "AI 日程与 /calendar create 共用并发上限（1–4）；0=默认 1"
      },
      "state_retention_days": {
        "description": "🗑️ 运行期状态保留期限",
        "type": "int",
        "default": 7,
        "hint": "运行期状态保留期（天）：过期日程生成状态与终态锁的回收窗口"
      }
    }
  },
  "time_awareness": {
    "description": "🕐 时笺设置",
    "type": "object",
    "items": {
      "time_guidance_enabled": {
        "description": "✅ 启用时笺（含现实时间）",
        "type": "bool",
        "default": true,
        "hint": "注入当前日期时间、时区、星期、时段与当日事项；动态内容仅当轮生效、不写入历史。建议关闭 AstrBot 自带现实时间感知避免重复"
      },
      "time_sensors": {
        "description": "📅 时间传感器（多选）",
        "type": "list",
        "options": [
          "workday",
          "lunar",
          "almanac"
        ],
        "labels": [
          "工作日",
          "农历",
          "黄历"
        ],
        "default": [
          "workday",
          "lunar"
        ],
        "hint": "勾选即启用，全不选则都不注入。工作日｜农历｜黄历（黄历建议与农历同开）"
      },
      "last_chat_enabled": {
        "description": "💬 上次对话时间感知",
        "type": "bool",
        "default": true,
        "hint": "注入距上次发言/回复的相对时间；首次对话不注入；ChatMemory 接管本轮时自动省略重复标签"
      },
      "use_astrbot_timezone": {
        "description": "🌐 跟随 AstrBot 时区",
        "type": "bool",
        "default": false,
        "hint": "优先使用 AstrBot 全局时区；未配置时回退到下方时区"
      },
      "timezone": {
        "description": "🕐 时区",
        "type": "string",
        "default": "",
        "hint": "IANA 时区，如 Asia/Shanghai；留空使用系统时区"
      },
      "workday_state_enabled": {
        "description": "📅 工作日性质感知",
        "type": "bool",
        "default": true,
        "hint": "标注今天是工作日、周末、调休工作日或节假日",
        "invisible": true
      },
      "lunar_state_enabled": {
        "description": "🌙 农历日期感知",
        "type": "bool",
        "default": true,
        "hint": "向 LLM 提供今日农历日期",
        "invisible": true
      },
      "almanac_enabled": {
        "description": "📜 黄历感知",
        "type": "bool",
        "default": false,
        "hint": "向 LLM 提供今日干支、冲煞和宜忌；建议与农历感知一同启用",
        "invisible": true
      }
    }
  },
  "daily_schedule": {
    "description": "🗓️ 单日日程表（时段状态感知）",
    "type": "object",
    "hint": "按时间段定义角色状态，向 LLM 提供当前命中的状态描述；时段左闭右开",
    "items": {
      "enable_schedule": {
        "description": "✅ 启用日程表感知",
        "type": "bool",
        "default": false,
        "hint": "向 LLM 提供当前命中时段的状态；AI 未命中时自动回退静态日程"
      },
      "schedule_templates": {
        "description": "🧱 静态日程时段",
        "type": "template_list",
        "condition": {
          "enable_schedule": true
        },
        "templates": {
          "time_slot": {
            "name": "⏰ 时段",
            "hint": "定义一个左闭右开 [开始时间, 结束时间) 的时段及其状态",
            "hide_hint_in_list": true,
            "display_item": "name",
            "items": {
              "name": {
                "description": "🏷️ 名称",
                "type": "string",
                "default": "",
                "hint": "时段标签，如「晨起」「午休」「深夜」"
              },
              "start_time": {
                "description": "▶️ 开始时间（HH:MM）",
                "type": "string",
                "default": "00:00",
                "hint": "HH:MM；开始时刻计入时段；结束早于开始=跨午夜"
              },
              "end_time": {
                "description": "⏹️ 结束时间（HH:MM）",
                "type": "string",
                "default": "06:00",
                "hint": "HH:MM；结束时刻不计入时段；跨午夜=次日时刻"
              },
              "state_prompt": {
                "description": "💬 状态描述(<SCHEDULE_STATE>)",
                "type": "text",
                "default": "",
                "hint": "50–200 字，描述生理/情绪/语气状态；无需 XML 标签"
              }
            }
          },
          "lunch_slot": {
            "name": "🍜 午餐时段（预设）",
            "hint": "预填 12:00–13:00 的午餐/午休状态（通用描写），可继续调整",
            "hide_hint_in_list": true,
            "display_item": "name",
            "items": {
              "name": {
                "description": "🏷️ 名称",
                "type": "string",
                "default": "午餐",
                "hint": "时段标签，仅用于展示和日志"
              },
              "start_time": {
                "description": "▶️ 开始时间（HH:MM）",
                "type": "string",
                "default": "12:00",
                "hint": "HH:MM；开始时刻计入时段；结束早于开始=跨午夜"
              },
              "end_time": {
                "description": "⏹️ 结束时间（HH:MM）",
                "type": "string",
                "default": "13:00",
                "hint": "HH:MM；结束时刻不计入时段；跨午夜=次日时刻"
              },
              "state_prompt": {
                "description": "💬 状态描述(<SCHEDULE_STATE>)",
                "type": "text",
                "default": "正在吃午餐或刚结束午餐。按人设自然回应——可提及咀嚼、餐具、餐桌氛围、饭后犯困或午间小憩的打算，语气放松从容，不因进食打断对话节奏。",
                "hint": "50–200 字，描述生理/情绪/语气状态；无需 XML 标签"
              }
            }
          },
          "dinner_slot": {
            "name": "🍲 晚餐时段（预设）",
            "hint": "预填 18:30–19:30 的晚餐状态（通用描写），可继续调整",
            "hide_hint_in_list": true,
            "display_item": "name",
            "items": {
              "name": {
                "description": "🏷️ 名称",
                "type": "string",
                "default": "晚餐",
                "hint": "时段标签，仅用于展示和日志"
              },
              "start_time": {
                "description": "▶️ 开始时间（HH:MM）",
                "type": "string",
                "default": "18:30",
                "hint": "HH:MM；开始时刻计入时段；结束早于开始=跨午夜"
              },
              "end_time": {
                "description": "⏹️ 结束时间（HH:MM）",
                "type": "string",
                "default": "19:30",
                "hint": "HH:MM；结束时刻不计入时段；跨午夜=次日时刻"
              },
              "state_prompt": {
                "description": "💬 状态描述(<SCHEDULE_STATE>)",
                "type": "text",
                "default": "正在吃晚餐或刚结束晚餐。按人设自然回应——可提及饭菜、餐桌氛围、饭后散步或收拾碗筷，语气松弛，带一点一天将尽的回味感，不打断对话节奏。",
                "hint": "50–200 字，描述生理/情绪/语气状态；无需 XML 标签"
              }
            }
          },
          "sleep_slot": {
            "name": "🌙 睡眠时段（预设）",
            "hint": "预填 22:00–08:00 的跨午夜睡眠状态，可继续调整",
            "hide_hint_in_list": true,
            "display_item": "name",
            "items": {
              "name": {
                "description": "🏷️ 名称",
                "type": "string",
                "default": "睡眠",
                "hint": "时段标签，仅用于展示和日志"
              },
              "start_time": {
                "description": "▶️ 开始时间（HH:MM）",
                "type": "string",
                "default": "22:00",
                "hint": "HH:MM；开始时刻计入时段；结束早于开始=跨午夜"
              },
              "end_time": {
                "description": "⏹️ 结束时间（HH:MM）",
                "type": "string",
                "default": "08:00",
                "hint": "HH:MM；结束时刻不计入时段；跨午夜=次日时刻"
              },
              "state_prompt": {
                "description": "💬 状态描述(<SCHEDULE_STATE>)",
                "type": "text",
                "default": "刚被消息叫醒或正在半梦半醒之间。按人设自然回应——可带困意、含糊、迟疑、不情愿，但不拒绝对话；允许偶尔走神、把话说半句、打哈欠。",
                "hint": "50–200 字，描述生理/情绪/语气状态；无需 XML 标签"
              }
            }
          }
        },
        "default": [],
        "hint": "按列表顺序左闭右开匹配，结束早于开始=跨午夜；AI 不写回；也可在 Plugin Page 分页管理"
      },
      "ai_daily": {
        "description": "🤖 AI 每日日程",
        "type": "object",
        "condition": {
          "enable_schedule": true
        },
        "hint": "按「当前 Persona + 本地日期」生成当天冻结快照；首次遇到新 Persona 异步补生成",
        "items": {
          "enabled": {
            "description": "✅ 启用 AI 每日日程",
            "type": "bool",
            "default": false,
            "hint": "每天按日期、世界观、人设与传感器生成日程；默认关闭，避免升级后自动调用模型"
          },
          "provider_id": {
            "description": "🤖 使用的模型",
            "type": "string",
            "default": "",
            "_special": "select_provider",
            "condition": {
              "enabled": true
            },
            "hint": "生成模型；留空用 AstrBot 全局默认 Provider"
          },
          "use_persona": {
            "description": "🧑 使用当前 Persona",
            "type": "bool",
            "default": true,
            "condition": {
              "enabled": true
            },
            "hint": "把当前 Persona prompt 作为生成依据，建议开启；关闭仍按 Persona 身份隔离"
          },
          "worldview": {
            "description": "🌍 世界观 / 长期背景",
            "type": "text",
            "default": "",
            "condition": {
              "enabled": true
            },
            "hint": "稳定的时代/地点/职业/生活背景；每日变化主题由模型自行生成"
          },
          "max_attempts": {
            "description": "🔁 单步 LLM 最大尝试次数",
            "type": "int",
            "default": 3,
            "condition": {
              "enabled": true
            },
            "hint": "1–5，含首次；作用于角色状态评估、方案生成与重复检测/评选，不会整套流程重复"
          },
          "generation_time": {
            "description": "⏰ 每日生成时刻",
            "type": "string",
            "default": "00:05",
            "condition": {
              "enabled": true
            },
            "hint": "HH:MM 当天生成当天；-HH:MM 前一天提前生成次日（如 -23:30 今晚生成明天）"
          },
          "max_slots": {
            "description": "🔢 AI 输出时段期望",
            "type": "int",
            "default": 24,
            "condition": {
              "enabled": true
            },
            "hint": "AI 输出时段数的期望值（约这个数，可多可少，不是硬上限；超出 60 条会被防失控安全上限截断）"
          },
          "retention_days": {
            "description": "🗃️ 快照保留天数",
            "type": "int",
            "default": 30,
            "condition": {
              "enabled": true
            },
            "hint": "快照保留天数（1–365，含当天）；不存原始 ID/prompt/历史"
          },
          "ai_priority_over_static": {
            "description": "🛡️ AI 优先于静态日程",
            "type": "bool",
            "default": false,
            "condition": {
              "enabled": true
            },
            "hint": "关=静态优先；开=AI 优先（用户层始终最高）"
          },
          "random_weather_enabled": {
            "description": "🎲 启用随机天气",
            "type": "bool",
            "default": false,
            "condition": {
              "enabled": true
            },
            "hint": "开启后每天随机当日天气基调（白天/黑夜各一段），对话注入、日程生成参考；天气由系统规定、预报=实况，默认池开箱即用，可在「天气池」自定义权重"
          },
          "weather_pool": {
            "description": "🎲 天气池（天气,权重）",
            "type": "list",
            "default": [
              "晴,30",
              "多云,25",
              "阴,15",
              "小雨,10",
              "雷阵雨,5",
              "大风,4",
              "雾,3"
            ],
            "condition": {
              "random_weather_enabled": true
            },
            "hint": "每行一条「天气,权重」，权重越高出现概率越大（白天/黑夜各自独立抽取）；非法行自动跳过，留空=内置默认池"
          },
          "adaptive": {
            "description": "🔄 自适应每日日程",
            "type": "object",
            "condition": {
              "enabled": true
            },
            "hint": "让日程在稳定习惯上产生有因果的日变化；全关时与基线一致（一次调用）",
            "items": {
              "enabled": {
                "description": "✅ 启用自适应增强",
                "type": "bool",
                "default": false,
                "hint": "自适应总开关；关闭时走基线单次调用流程"
              },
              "recent_days": {
                "description": "🗓️ 参考最近日程天数",
                "type": "int",
                "default": 0,
                "condition": {
                  "enabled": true
                },
                "hint": "0=关闭；1–30=注入最近 N 天日程摘要并反重复"
              },
              "theme_pool": {
                "description": "🎲 每日主题类型池",
                "type": "list",
                "default": [
                  "演习日",
                  "远征日",
                  "港区休整日",
                  "外出日",
                  "宅家日",
                  "社交日",
                  "学习日",
                  "购物日",
                  "整理日",
                  "休闲漫游日",
                  "低能量恢复日",
                  "特别纪念日"
                ],
                "condition": {
                  "enabled": true
                },
                "hint": "Step1 从中挑选当日主题类型；清空=自由标签。需同时开启「角色状态连续性」才生效"
              },
              "style_pool": {
                "description": "🎨 每日状态色彩池",
                "type": "list",
                "default": [
                  "慵懒",
                  "活力",
                  "优雅",
                  "俏皮",
                  "温柔",
                  "冷峻",
                  "元气",
                  "随性",
                  "沉稳",
                  "浪漫"
                ],
                "condition": {
                  "enabled": true
                },
                "hint": "Step1 从中挑选当日状态色彩；清空=关闭该维度。需同时开启「角色状态连续性」才生效"
              },
              "allow_custom_theme": {
                "description": "✍️ 允许自创主题/风格",
                "type": "bool",
                "default": true,
                "condition": {
                  "enabled": true
                },
                "hint": "开=池内优先、无合适项可自创（禁「常规日」类空泛词）；关=严格池内"
              },
              "state_continuity_enabled": {
                "description": "🧩 角色状态连续性",
                "type": "bool",
                "default": false,
                "condition": {
                  "enabled": true
                },
                "hint": "开启时先做角色状态评估（Step1）再生成方案（Step2），并参与连续性评分；关闭时只按反重复排序"
              },
              "candidate_count": {
                "description": "🎯 规划方案数",
                "type": "int",
                "default": 1,
                "condition": {
                  "enabled": true
                },
                "hint": "独立生成方案数（1–5）"
              },
              "candidate_selection": {
                "description": "⚖️ 方案选择方式",
                "type": "string",
                "default": "heuristic",
                "options": [
                  "heuristic",
                  "llm"
                ],
                "condition": {
                  "enabled": true
                },
                "hint": "heuristic=本地评分不增调用；llm=额外模型评选，失败回退 heuristic；方案数>1 才生效"
              },
              "context_token_budget": {
                "description": "📏 增强上下文 Token 上限",
                "type": "int",
                "default": 0,
                "condition": {
                  "enabled": true
                },
                "hint": "增强上下文 Token 上限；0=自动按 Provider 窗口 80% 分配（取不到回退 8000）"
              },
              "max_concurrent_llm": {
                "description": "🌐 全局并发上限（旧位置·兼容回退）",
                "type": "int",
                "default": 1,
                "invisible": true,
                "hint": "旧位置兼容回退：顶层 runtime.llm_max_concurrency 优先（1–4）；未配置或为 0 时才用此值（AI 日程共用）"
              },
              "acquire_timeout_seconds": {
                "description": "⏳ 并发等待超时",
                "type": "int",
                "default": 10,
                "condition": {
                  "enabled": true
                },
                "hint": "等并发槽位超时秒数（0–120）；超时回退旧快照/静态日程，不阻塞消息"
              }
            }
          }
        }
      }
    }
  },
  "calendar": {
    "description": "📅 日历事项设置",
    "type": "object",
    "items": {
      "enable_calendar": {
        "description": "✅ 启用日历事项感知",
        "type": "bool",
        "default": false,
        "hint": "注入当日事项；无事项不注入"
      },
      "ai_generate_provider_id": {
        "description": "🤖 AI 生成日历使用的模型(provider_id)",
        "type": "string",
        "default": "",
        "_special": "select_provider",
        "hint": "/calendar create 使用的模型；留空用当前会话模型"
      },
      "ai_generate_worldview": {
        "description": "🌍 默认世界观设定（可空）",
        "type": "text",
        "default": "",
        "hint": "/calendar create 的世界观；生成会替换全部自定义事项，不影响内置事件"
      },
      "ai_generate_max_events": {
        "description": "🔢 AI 日历单次生成事项期望",
        "type": "int",
        "default": 40,
        "hint": "/calendar create 单次生成的自定义事项条数期望值（约这个数，可多可少，不是硬上限；超出 400 条会被防失控安全上限截断）"
      },
      "builtin_event_categories": {
        "description": "🏷️ 内置现实事件分类（多选）",
        "type": "list",
        "options": [
          "legal_holidays",
          "traditional",
          "solar_terms",
          "political",
          "international"
        ],
        "labels": [
          "法定节假日（含调休）",
          "传统农历节日",
          "二十四节气",
          "政治纪念日",
          "国际/西方节日"
        ],
        "default": [
          "legal_holidays",
          "traditional",
          "solar_terms"
        ],
        "hint": "勾选任意分类即启用内置现实事件，全不选则关闭；每年自动更新"
      },
      "enable_builtin_events": {
        "description": "✅ 启用内置现实日历事件",
        "type": "bool",
        "default": true,
        "hint": "自动提供节假日、传统节日和节气等现实事件，每年更新",
        "invisible": true
      },
      "builtin_events": {
        "description": "📅 内置事件分类开关",
        "type": "object",
